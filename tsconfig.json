{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "allowJs": false,
    "checkJs": false,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "incremental": true,
    "paths": {
      "@iivkis/shared": ["./packages/shared/src"],
      "@iivkis/shared/*": ["./packages/shared/src/*"],
      "@iivkis/ui": ["./packages/ui/src"],
      "@iivkis/ui/*": ["./packages/ui/src/*"],
      "@iivkis/agents-analysis": ["./packages/agents/analysis/src"],
      "@iivkis/agents-analysis/*": ["./packages/agents/analysis/src/*"],
      "@iivkis/agents-integration": ["./packages/agents/integration/src"],
      "@iivkis/agents-integration/*": ["./packages/agents/integration/src/*"],
      "@iivkis/agents-troubleshooting": ["./packages/agents/troubleshooting/src"],
      "@iivkis/agents-troubleshooting/*": ["./packages/agents/troubleshooting/src/*"],
      "@iivkis/agents-vendor-knowledge": ["./packages/agents/vendor-knowledge/src"],
      "@iivkis/agents-vendor-knowledge/*": ["./packages/agents/vendor-knowledge/src/*"]
    }
  },
  "exclude": [
    "node_modules",
    "dist",
    "build",
    ".next",
    "coverage",
    "**/dist",
    "**/build",
    "**/.next",
    "**/coverage"
  ]
}
