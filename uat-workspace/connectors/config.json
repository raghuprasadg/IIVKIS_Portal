{
  "version": "1.0.0",
  "description": "UAT mock connector configurations — pre-wired for demo testing without live credentials",
  "tenantId": "tenant-uat",
  "connectors": [
    {
      "id": "conn-servicenow",
      "name": "ServiceNow (Mock)",
      "type": "itsm",
      "vendor": "ServiceNow",
      "enabled": true,
      "mode": "mock",
      "baseUrl": "http://mock-servicenow:8080",
      "authType": "oauth2_client_credentials",
      "credentials": {
        "clientId": "uat-client-id",
        "clientSecret": "__MOCK__",
        "tokenEndpoint": "http://mock-servicenow:8080/oauth/token",
        "scopes": ["incident.read", "incident.write", "cmdb.read"]
      },
      "fieldMapping": {
        "incidentId": "number",
        "title": "short_description",
        "description": "description",
        "severity": "priority",
        "status": "state",
        "assignee": "assigned_to",
        "affectedCi": "cmdb_ci",
        "occurredAt": "opened_at"
      },
      "webhookReceivePath": "/integrations/webhook/servicenow",
      "syncIntervalSeconds": 300,
      "capabilities": ["ingest_incidents", "create_incident", "update_incident", "query_cmdb"],
      "healthCheckUrl": "http://mock-servicenow:8080/health",
      "status": "healthy",
      "lastSyncAt": "2026-01-15T10:00:00Z"
    },
