# IIVKIS Local Development — Environment Variables
# Copy this file to .env (gitignored) and edit as needed.
# Values shown here are safe dev-only defaults.

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=iivkis
POSTGRES_PASSWORD=iivkis_dev_pass
POSTGRES_DB=iivkis
POSTGRES_PORT=5432

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=iivkis_dev_pass
REDIS_PORT=6379

# ─── Neo4j ────────────────────────────────────────────────────────────────────
NEO4J_USER=neo4j
NEO4J_PASSWORD=iivkis_dev_pass
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# ─── Keycloak ─────────────────────────────────────────────────────────────────
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev_pass
KEYCLOAK_PORT=8080
KEYCLOAK_REALM=iivkis
KEYCLOAK_CLIENT_ID=iivkis-api
# IMPORTANT: rotate this secret in any non-local environment
KEYCLOAK_CLIENT_SECRET=change-me-in-production

# ─── Vault ────────────────────────────────────────────────────────────────────
# WARNING: this is the DEV-MODE root token; never use in production.
VAULT_DEV_ROOT_TOKEN=iivkis-dev-root-token
VAULT_PORT=8200

# ─── Prometheus ───────────────────────────────────────────────────────────────
PROMETHEUS_PORT=9090

# ─── Grafana ──────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=iivkis_dev_pass
GRAFANA_PORT=3001

# ─── IIVKIS API ───────────────────────────────────────────────────────────────
API_PORT=4000
